# Normalize line endings to LF in working copy on all platforms.
# core.autocrlf=true (Git for Windows global default) is overridden
# by explicit eol=lf per-pattern below.

# Dart / Flutter
*.dart  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Kotlin / Android
*.kt    text eol=lf
*.kts   text eol=lf
*.gradle text eol=lf
*.xml   text eol=lf
*.pro   text eol=lf

# Python / shell scripts
*.py    text eol=lf
*.sh    text eol=lf

# Lock / config files
*.lock  text eol=lf
*.toml  text eol=lf

# Binary files — never convert
*.tflite binary
*.bin    binary
*.param  binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.db     binary
*.zip    binary
*.jar    binary
*.aar    binary
